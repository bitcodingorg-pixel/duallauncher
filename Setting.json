 "_help": { 
 "modes": "\"mode\": \"percentage\" = har unit ka \"percentage\" chalega (jaise AdX 60, Facebook 40: 100 me se 60 ads AdX se pehle maange jayenge, 40 Facebook se). \"mode\": \"rotation\" = percentage ignore, ek ke baad ek unit (AdX, Facebook, AdX...). Dono me jo unit fill na kare uske baad list ka agla unit try hota hai. Khaali id wala unit aur uska percentage skip hote hain.", 
 "network": "\"admob\" (ca-app-pub-xxx/yyy), \"adx\" (/123,456/path), \"facebook\" (Meta placement id 1234567890_1234567890). Id se network khud pehchana jata hai.", 
 "empty_id": "\"id\": \"\" wala unit skip hota hai. Facebook / AdMob id bharte hi woh unit chalu ho jayega.", 
 "facebook_app_open": "Meta me App Open format nahi hota: app_open me facebook ki Interstitial placement id daalo.", 
 "facebook_native": "\"type\": \"native\" = Meta Native placement (badi image/video, sirf badi jagah: clone opening screen, launcher home large, AI Studio loader). \"type\": \"native_banner\" = Meta Native Banner placement (chhoti jagah: app list, dialogs, tools). Dono daalo to har jagah Facebook ad aa sakta hai.", 
 "facebook_block": "ads.facebook.enabled false = sab Facebook units band (baaki chalte rahenge). test_mode true = Meta test ads (sirf testing ke liye, live par false). test_devices = Meta log ka \"Test mode device hash\".", 
 "facebook_rewarded": "Rewarded me Meta ke dono format chalte hain: \"Rewarded Video\" aur \"Rewarded Interstitial\". \"type\": \"rewarded_interstitial\" likho to seedha usi tarah maanga jata hai. type na likho to pehle Rewarded Video, aur error 1203 aaye to khud Rewarded Interstitial try hota hai.", 
 "facebook_pending": "interstitial + app_open ka facebook id khaali hai: diya gaya Intra id (..._1929716941393103) Banner placement hai (Meta error 1203). Meta Monetization Manager me ek Interstitial placement banao aur uska id interstitial + app_open dono ke facebook unit me daalo. native ka \"native_banner\" unit bhi khaali hai: ek \"Native Banner\" placement banao (chhoti jagah ke liye). Tab tak wahan AdX chalega.", 
 "order": "Har list ka order: AdMob (60), Facebook (40), AdX (0). Pehla ad percentage se chuna jata hai (100 me se 60 baar AdMob, 40 baar Facebook). Woh fail ho to doosra (AdMob/Facebook), dono fail hon to aakhir me AdX. AdX ka percentage 0 = woh kabhi pehle nahi maanga jata, sirf last fallback." 
 } 
 }, 
